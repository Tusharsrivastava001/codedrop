{
  "env": {
    "commonjs": true,
    "es2022": true,
    "jest": true,
    "node": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "camelcase": "off",
    "consistent-return": "off",
    "global-require": "off",
    "import/no-extraneous-dependencies": "off",
    "max-len": ["error", { "code": 140 }],
    "no-console": "off",
    "no-param-reassign": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}
